{
  "name": "visionsby_mon",
  "version": "1.0.0",
  "description": "Visionsby_MON Luxury Clothing Store - Decoupled Frontend & Backend Monorepo",
  "scripts": {
    "start": "npm run dev",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm start",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "npm run dev:server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
